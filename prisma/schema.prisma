generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Role {
  id        String   @id @default(cuid())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  users     User[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model User {
  id                   String                @id @default(cuid())
  fullName             String
  email                String                @unique
  mrCode               String?               @unique
  passwordHash         String
  roleId               String
  departmentId         String
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  role                 Role                  @relation(fields: [roleId], references: [id])
  department           Department            @relation(fields: [departmentId], references: [id])
  productionLogs       ProductionLog[]
  reportedIncidents    SafetyIncident[]
  assignedTransports   Transport[]
  materialTransactions MaterialTransaction[]
  aiAuditLogs          AiAgentAuditLog[]
  shiftEntries         ShiftEntry[]
  shiftParticipant     ShiftParticipant?
  shiftArchives        ShiftArchive[]

  @@index([isActive, fullName])
}

model ShiftParticipant {
  id      String   @id @default(cuid())
  userId  String   @unique
  addedAt DateTime @default(now())
  user    User     @relation(fields: [userId], references: [id])
}

model ShiftEntry {
  id            String   @id @default(cuid())
  userId        String
  date          String
  shiftCode     String
  overtimeHours Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([date])
}

model ShiftArchive {
  id          String   @id @default(cuid())
  startDate   String
  endDate     String
  title       String
  snapshot    Json
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   User     @relation(fields: [createdById], references: [id])

  @@unique([startDate, endDate])
  @@index([createdAt])
}

model Material {
  id             String                @id @default(cuid())
  name           String
  category       String
  unit           String
  currentStock   Float
  minimumStock   Float
  maximumStock   Float                 @default(0)
  location       String
  transactions   MaterialTransaction[]
  productionLogs ProductionLog[]
  transports     Transport[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([name])
}

model MaterialTransaction {
  id              String   @id @default(cuid())
  materialId      String
  type            String // "IN" or "OUT"
  quantity        Float
  note            String?
  transactionDate DateTime @default(now())
  createdById     String
  createdAt       DateTime @default(now())
  material        Material @relation(fields: [materialId], references: [id])
  createdBy       User     @relation(fields: [createdById], references: [id])

  @@index([transactionDate])
  @@index([type, transactionDate])
  @@index([materialId, transactionDate])
}

model ProductionLog {
  id              String    @id @default(cuid())
  lotNumber       String
  productionDate  DateTime
  shift           String    @default("өдрийн")
  productName     String
  outputQuantity  Float
  scheduledDate   DateTime?
  destinationMine String?
  status          String    @default("ready")
  materialId      String
  quantityUsed    Float     @default(0)
  downtimeMinutes Int       @default(0)
  workerInfo      String?   @db.Text
  density         Float?
  note            String?   @db.Text
  createdById     String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
  material        Material  @relation(fields: [materialId], references: [id])
  createdBy       User      @relation(fields: [createdById], references: [id])
  telemetryLogs   EquipmentTelemetryLog[]

  @@index([productionDate])
  @@index([scheduledDate])
  @@index([materialId, productionDate])
}

model Equipment {
  id            String                  @id @default(cuid())
  name          String                  @unique
  type          String
  maxRpm        Float
  department    String
  isActive      Boolean                 @default(true)
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  telemetryLogs EquipmentTelemetryLog[]

  @@index([department, isActive])
  @@index([type])
}

model EquipmentTelemetryLog {
  id              String        @id @default(cuid())
  productionLogId String
  equipmentId     String
  rpm             Float
  maxRpm          Float
  loadPercent     Float
  temperature     Float?
  pressure        Float?
  vibration       Float?
  status          String
  note            String?       @db.Text
  recordedAt      DateTime
  createdAt       DateTime      @default(now())
  productionLog   ProductionLog @relation(fields: [productionLogId], references: [id], onDelete: Cascade)
  equipment       Equipment     @relation(fields: [equipmentId], references: [id])

  @@index([recordedAt])
  @@index([equipmentId, recordedAt])
  @@index([productionLogId])
  @@index([status, recordedAt])
}

model DailyProductionPlan {
  id             String   @id @default(cuid())
  planDate       DateTime @unique
  targetQuantity Float
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model SafetyIncident {
  id           String   @id @default(cuid())
  title        String
  description  String   @db.Text
  severity     String
  status       String   @default("open")
  incidentDate DateTime
  location     String
  reportedById String
  createdAt    DateTime @default(now())
  reportedBy   User     @relation(fields: [reportedById], references: [id])

  @@index([incidentDate])
  @@index([status, incidentDate])
}

model Transport {
  id              String    @id @default(cuid())
  materialId      String
  quantity        Float
  destinationSite String
  driverInfo      String?
  vehicleInfo     String?
  transportDate   DateTime
  deliveryDate    DateTime?
  status          String
  note            String?
  assignedUserId  String
  createdAt       DateTime  @default(now())
  material        Material  @relation(fields: [materialId], references: [id])
  assignedUser    User      @relation(fields: [assignedUserId], references: [id])

  @@index([transportDate])
  @@index([status, transportDate])
  @@index([materialId, transportDate])
}

model AiAgentAuditLog {
  id         String   @id @default(cuid())
  userId     String
  toolName   String
  actionType String
  success    Boolean  @default(false)
  summary    String   @db.Text
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
  @@index([toolName, createdAt])
}
