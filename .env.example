# Use your own MySQL password if your local root user has one.
# Recommended database/schema name: dragon_city
DATABASE_URL="mysql://root:YOUR_PASSWORD@localhost:3306/dragon_city"

# AI quick entry. Keep the real key only in local .env / deployment secrets.
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-5.5"

# Required in production. Generate a long random value and keep it secret.
JWT_SECRET="replace-with-a-long-random-string"
