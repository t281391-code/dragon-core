# Server-only environment variables.
# Never prefix DATABASE_URL, JWT_SECRET, or OPENAI_API_KEY with NEXT_PUBLIC_.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Generate a long random value and keep it secret.
JWT_SECRET="replace-with-a-long-random-string"

# Optional AI quick entry. Keep the real key only in local .env / deployment secrets.
OPENAI_API_KEY="sk-your-openai-api-key-placeholder"
OPENAI_MODEL="gpt-5.4-nano"

# Recommended for production unless you intentionally allow public signup.
ALLOW_PUBLIC_REGISTRATION="false"
